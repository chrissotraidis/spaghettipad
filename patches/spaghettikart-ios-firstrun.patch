+static bool IsUsableGameArchive(const std::string& path) {
+    int errorCode = 0;
+    zip_t* archive = zip_open(path.c_str(), ZIP_RDONLY | ZIP_CHECKCONS, &errorCode);
+    if (archive == nullptr) {
+        return false;
+    }
+
+    const bool hasManifest = zip_name_locate(archive, "mods.toml", 0) >= 0;
+    zip_close(archive);
+    return hasManifest;
+}
